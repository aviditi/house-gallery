# Copy this file to ".env" and configure ONE provider below.
# Without a working residential proxy, Zillow/StreetEasy return HTTP 403.

# Which fetch engine to use:
#   scraperapi | zenrows | scrapeops   -> scraping API (set PROXY_API_KEY)
#   webshare                           -> raw proxy endpoint (set PROXY_URL)
#   direct                             -> no proxy (will be blocked by Zillow)
PROXY_PROVIDER=webshare

# --- For scraperapi / zenrows / scrapeops: put your API key here ---
PROXY_API_KEY=

# --- For webshare (or any raw proxy): full proxy connection string ---
# Get this from your Webshare dashboard (use a RESIDENTIAL proxy; the free
# datacenter proxies are blocked by Zillow). Format:
#   http://USERNAME:PASSWORD@HOST:PORT
# Webshare's rotating residential endpoint looks like:
#   http://user-rotate:pass@p.webshare.io:80
PROXY_URL=

# Port the local server listens on (optional, default 3000).
PORT=3000
